# Chave da Anthropic (Claude) - entende o que foi falado e monta o compromisso
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Chave da Groq - transforma o áudio em texto (transcrição). Grátis, sem cartão.
# https://console.groq.com/keys
GROQ_API_KEY=

# (Opcional) Em vez da Groq, dá para usar a OpenAI (paga). Só é usada se GROQ_API_KEY estiver vazia.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Senha (PIN) que o cliente digita para abrir o app. Troque!
APP_PIN=1234

# Fuso horário do cliente
TZ=America/Sao_Paulo

# Porta do servidor
PORT=3000
